@startuml c4-container-diagram
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()

AddRelTag("future", $lineStyle = DashedLine(), $lineColor = "gray", $textColor = "gray")

title КиноБездна - To-Be Container Diagram

Person(user, "Пользователь", "Браузер / Мобильное / Smart TV")

System_Ext(recsys, "Рекомендательная система", "Внешний сервис подборок")
System_Ext(payment, "Платёжная система", "Внешний сервис обработки платежей")

System_Boundary(platform, "Платформа КиноБездна") {

    Container(proxy, "Proxy Service", "Node.js / Express", "API Gateway.\nПаттерн Strangler Fig.\nПостепенная миграция трафика\nчерез feature flag.")

    Container(monolith, "Монолит", "Go", "Пользователи, платежи,\nподписки, просмотры.\nПорт 8080.")

    Container(movies, "Movies Service", "Go", "Выделенный микросервис.\nМетаданные фильмов, жанры,\nрейтинги. Порт 8081.")

    Container(events, "Events Service", "Node.js / Express", "Kafka producer/consumer.\nСобытия фильмов, пользователей,\nплатежей. Порт 8082.")

    ContainerDb(postgres_monolith, "PostgreSQL (Монолит)", "PostgreSQL 14", "users, payments,\nsubscriptions, views,\netc.")

    ContainerDb(postgres_movies, "PostgreSQL (Movies)", "PostgreSQL 14", "movies, movie_genres,\nuser_ratings")

    ContainerQueue(kafka, "Kafka", "Apache Kafka 2.7", "Топики: movie-events,\nuser-events,\npayment-events.")

    Container(zookeeper, "ZooKeeper", "Apache ZooKeeper", "Координация Kafka.")
}

Rel(user, proxy, "API-запросы", "HTTP")
Rel(proxy, monolith, "API-запросы", "HTTP")
Rel(proxy, movies, "API-запросы", "HTTP")
Rel(proxy, events, "API-запросы", "HTTP")

Rel(monolith, postgres_monolith, "Чтение / Запись", "SQL")
Rel(movies, postgres_movies, "Чтение / Запись", "SQL")

Rel(events, kafka, "Публикация / Чтение", "Kafka")
Rel(kafka, zookeeper, "Координация", "ZK")

Rel(monolith, recsys, "Получение рекомендаций", "HTTP")
Rel(monolith, payment, "Обработка платежей", "HTTP")

Rel(kafka, monolith, "Потребление событий (целевое)", "Kafka", $tags="future")
Rel(kafka, recsys, "Потребление событий (целевое)", "Kafka", $tags="future")

@enduml
